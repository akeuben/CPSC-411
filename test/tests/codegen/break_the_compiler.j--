// mostly break statement checking, but needs other J-- facilities to work

main() {
	i = 0;
	brake();
	i = 1;
	brake();
}

int i;

void brake() {
	prints("i is ");
	printi(i);
	prints("\n");

	while (i >= 0) {
		prints("    should see this when i >= 0\n");
		if (i == 0)
			break;
		prints("    should NOT see this when i == 0\n");

		while (i >= 1) {
			prints("    should see this when i >= 1\n");
			break;
			prints("    should NOT see this when i >= 1\n");
		}

		prints("    should also see this when i >= 1\n");
		break;
		prints("    should NOT see this when i >= 1\n");
	}
	prints("    should always see this\n");
}
