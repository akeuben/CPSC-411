// find minint the hard way

main() {
	int i;
	int delta;
	
	i = 0;
	delta = 1000000;

	// larger increments until we overshoot
	while (i > i-delta)
		i = i + delta;
	i = i - delta;

	// walk it back down
	while (i > i-1)
		i = i + 1;

	prints("minint is ");
	printi(i);
	prints("\n");
}
